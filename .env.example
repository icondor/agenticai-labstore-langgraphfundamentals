# Modelul care GENEREAZA raspunsuri (ca in Lab 11)
# Valori: anthropic | gemini | openai | ollama | azureopenai | xai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# Modelul care CAUTA dupa sens (embeddings), la fel ca in Lab 11
EMBEDDINGS_PROVIDER=google
GOOGLE_API_KEY=...
# Optional; implicit gemini-embedding-001 la Google
# EMBEDDINGS_MODEL=gemini-embedding-001

# Doar pentru verificare offline, fara chei si fara cost: vectori FALSI, pe
# concepte. Demonstreaza mecanismul Store-ului, NU calitatea unui model real.
# EMBEDDINGS_PROVIDER=fals

# Scorul minim sub care o amintire gasita prin cautare semantica e ignorata.
# Punct de pornire, NU adevar: calibreaza-l pe datele tale (demo4 afiseaza scorurile).
# PRAG_SCOR=0.5
